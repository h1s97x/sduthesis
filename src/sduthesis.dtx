% \section{简介}
%
% SDUThesis 是为山东大学学位论文设计的 \LaTeX{} 模板类，致力于让
% 论文排版从繁琐的格式细节中解放出来，让作者把精力集中在内容本身。
% 模板在 \textsf{ctexbook} 文档类的基础上构建，原生支持中文排版，
% 无需手工调整字号、行距、页边距等格式参数即可达到学校规范要求。
% 通过单一的 \cs{SDUSetup} 配置命令，即可集中完成论文标题、作者、
% 学院、专业、指导教师等全部信息的录入。
%
% 除了开箱即用的基本功能，模板还提供了一套插件化架构。整个系统分为
% 内核（\texttt{sduthesis.cls}）与若干可选的 \emph{模块}
% （\texttt{modules/} 目录下的 \texttt{.sty} 文件）。内核负责提供
% 基础排版能力与统一的配置/扩展接口，模块则针对具体场景（本科、硕士、
% 盲审等）定制封面版式与页面内容。这种设计类似 VS Code 的扩展模式，
% 用户可以根据自己的论文类型按需组合模块，而不必修改内核代码。
%
% 模板的主要特点可归纳为：
%
% \begin{itemize}
%   \item 基于 \textsf{ctexbook} 文档类，完美支持中文排版
%   \item 插件化架构：内核 + 模块，类似 VS Code 的扩展模式
%   \item \cs{SDUSetup} 集中配置接口，基于 LaTeX3 l3keys 机制
%   \item Hook 系统：六个文档阶段钩子，模块可注入任意行为
%   \item 支持盲审模式（\texttt{blindreview} 模块）
%   \item 支持硕士学位论文（\texttt{master} 模块）
%   \item 支持多模块组合加载（如 \texttt{master + blindreview}）
%   \item 兼容 Overleaf 在线编辑
% \end{itemize}
%
% \section{系统要求}
%
% 模板基于现代 \TeX{} 工具链构建，为保证最佳兼容性与排版效果，请使用
% 较新版本的 \TeX{} 发行版。以下环境均为推荐配置，满足后即可直接编译：
%
% \begin{itemize}
%   \item \TeX{} Live 2024 或更高版本
%   \item XeLaTeX 编译器
%   \item Biber 参考文献处理器
%   \item Fandol 字体集（\TeX{} Live 自带）
% \end{itemize}
%
% \section{快速开始}
%
% 下面通过一个最小的可编译示例，展示使用模板完成一篇论文骨架所需的全部
% 步骤。完整步骤分为三步：
%
% \begin{enumerate}
%   \item 在项目根目录放置 \texttt{main.tex}，在\emph{导言区}加载模板类并
%         通过 \cs{SDUSetup} 录入论文基本信息；
%   \item 在文档环境中调用封面、目录等前置命令，并撰写正文；
%   \item 用 XeLaTeX 配合 Biber 编译，得到最终的 PDF。
% \end{enumerate}
%
% \subsection{最小示例}
%
% 首先创建一个主文件（如 \texttt{main.tex}），文档类声明为
% \texttt{sduthesis}，随后用 \cs{SDUSetup} 集中配置论文信息。
% 推荐用 \texttt{info=\{...\}} 分组收纳论文信息，\texttt{module} 键
% 指定论文类型（此处为本科），\texttt{year}/\texttt{month} 等缺省键按需填写：
%
% \begin{lstlisting}[language={[LaTeX]TeX}]
% \documentclass{sduthesis}
% \SDUSetup{
%   module  = undergraduate,
%   info    = {
%     title      = {论文题目},
%     author     = {作者姓名},
%     studentId  = {学号},
%     school     = {学院},
%     major      = {专业},
%     supervisor = {指导教师},
%     year       = {2025},
%     month      = {6},
%   },
% }
% \begin{document}
% \makecoverpage
% \maketable
% % 正文...
% \end{document}
% \end{lstlisting}
%
% 若你沿用旧版本写法，也可以把所有键平铺在 \cs{SDUSetup} 顶层，效果相同。
%
% \subsection{编译命令}
%
% \LaTeX{} 文档的引用、目录与参考文献需要多次编译才能稳定。模板使用
% XeLaTeX 配合 Biber 处理中文与参考文献，共需要四次编译。其中第一次
% \texttt{xelatex} 生成辅助文件，\texttt{biber} 处理参考文献数据，
% 后两次 \texttt{xelatex} 分别用于嵌入引用与解析交叉引用：
%
% \begin{enumerate}
%   \item \texttt{xelatex main} --- 生成辅助文件
%   \item \texttt{biber main} --- 处理参考文献
%   \item \texttt{xelatex main} --- 嵌入引用
%   \item \texttt{xelatex main} --- 解析交叉引用
% \end{enumerate}
%
% 或使用 \texttt{just build} 一键编译。
%
% \section{配置参考}
%
% 模板的所有可配置项均通过 \cs{SDUSetup} 以\emph{键值对}的形式集中传入。
% 配置键分为三组：\textbf{info}（论文元数据：信息 + 学位信息）、
% \textbf{option}（排版参数）以及顶层的 \textbf{module}（指定加载哪些模块）。
% 推荐用嵌套分组写法，语义更清晰；同时保留平铺写法，新旧代码均可用。
%
% \subsection{两种写法}
%
% \textbf{嵌套分组（推荐）}：用 \texttt{info=\{...\}} 收纳论文信息，
% \texttt{option=\{...\}} 收纳样式参数，\texttt{module} 直接写在顶层：
%
% \begin{lstlisting}[language={[LaTeX]TeX}]
% \SDUSetup{
%   module  = undergraduate,
%   info    = {
%     title      = {论文题目},
%     author     = {作者姓名},
%     studentId  = {学号},
%     school     = {学院},
%     major      = {专业},
%     supervisor = {指导教师},
%     year       = {2025},
%     month      = {6},
%   },
%   option  = { lineSpread = 1.5 },
% }
% \end{lstlisting}
%
% \textbf{平铺写法（兼容旧版）}：所有键直接平铺在顶层，行为与旧版本一致：
%
% \begin{lstlisting}[language={[LaTeX]TeX}]
% \SDUSetup{
%   module     = undergraduate,
%   title      = {论文题目},
%   author     = {作者姓名},
%   lineSpread = 1.5,
% }
% \end{lstlisting}
%
% 两种写法可混用，键名不冲突：嵌套的 \texttt{info}/\texttt{option} 与
% 顶层平铺的键都会设置到同一组内部变量上。
%
